{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mira-docs.dev/schemas/content.schema.json",
  "title": "MiraDocs Content Frontmatter",
  "type": "object",
  "required": ["title"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "path": { "type": "string", "pattern": "^/" },
    "type": {
      "type": "string",
      "enum": ["doc", "article", "project", "page"]
    },
    "group": { "type": "string" },
    "order": { "type": "number" },
    "date": { "type": "string" },
    "status": { "type": "string" },
    "cover": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
