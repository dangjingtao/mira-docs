{
  "name": "@mira/docs",
  "version": "0.1.0-dev.20260725",
  "description": "Git-native documentation, publishing, and project portal runtime",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup src/index.ts src/vite.ts --format esm --dts --clean && node scripts/copy-styles.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "marked": "^15.0.12",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
